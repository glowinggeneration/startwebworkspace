# Supabase — required. Create a project at https://supabase.com and copy
# these from Project Settings > API. Never commit the real values.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses Row Level Security — never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=
