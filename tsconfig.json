{
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "eslint.config.js"],
  "exclude": [
    "src/components/vendor/magicui/cool-mode.tsx",
    "src/components/vendor/magicui/dia-text-reveal.tsx",
    "src/components/vendor/magicui/tweet-card.tsx",
    "src/components/vendor/collection/calendar-widget.tsx",
    "src/components/vendor/collection/carousel-navigator.tsx",
    "src/components/vendor/collection/compose-email-card.tsx",
    "src/components/vendor/collection/frequency-selector.tsx",
    "src/components/vendor/collection/inline-action.tsx",
    "src/components/vendor/collection/mega-navigation.tsx",
    "src/components/vendor/collection/mega-navigation.demo.tsx",
    "src/components/vendor/collection/model-selection-dropdown.tsx",
    "src/components/vendor/collection/predictive-text-input.tsx",
    "src/components/vendor/collection/run-action-button.tsx",
    "src/components/vendor/collection/soft-date-range-calendar.tsx",
    "src/components/vendor/collection/step-pager.tsx",
    "src/components/vendor/collection/team-profile-accordion.tsx",
    "src/components/vendor/secondary/AnimatedNumberBasic.tsx",
    "src/components/vendor/secondary/AppleStyleDock.tsx",
    "src/components/vendor/secondary/CarouselBasic.tsx",
    "src/components/vendor/secondary/CarouselCustomIndicator.tsx",
    "src/components/vendor/secondary/CarouselCustomSizes.tsx",
    "src/components/vendor/secondary/CarouselSpacing.tsx",
    "src/components/vendor/secondary/DialogBasic.tsx",
    "src/components/vendor/secondary/InlineAction.tsx",
    "src/components/vendor/secondary/ScrollProgressBasic1.tsx",
    "src/components/vendor/secondary/SegmentedControl.tsx",
    "src/components/vendor/secondary/TabsTransitionPanel.tsx",
    "src/components/vendor/secondary/ToolbarDynamic.tsx",
    "src/components/vendor/secondary/ToolbarExpandable.tsx"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,

    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
